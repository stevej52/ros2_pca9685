<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ros2_pca9685</name>
  <version>1.0.0</version>
  <description>ROS 2 driver for the PCA9685 16-channel PWM/servo controller (I2C)</description>
  <maintainer email="stevej52@gmail.com">stevej52</maintainer>
  <license>Apache-2.0</license>
  <url type="repository">https://github.com/stevej52/ros2_pca9685</url>
  <url type="bugtracker">https://github.com/stevej52/ros2_pca9685/issues</url>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
